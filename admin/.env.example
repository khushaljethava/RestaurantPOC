# Copy to .env and fill in. Mirror these in Vercel → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_ACCESS_TOKEN=sbp_...

# Base URL used to build shareable invite links (/staff → Copy link).
# Must be the STABLE production host, not a per-deployment preview URL —
# a preview host changes on every push and would bake a dead link into an
# invite someone already sent.
NEXT_PUBLIC_SITE_URL=https://restaurant-poc-eight.vercel.app

# Shown on the public /join page as "Don't have the app? Download it".
# Direct APK link while unpublished; swap for the Play Store URL at launch.
# If unset, the download line is simply not rendered.
NEXT_PUBLIC_APK_URL=
